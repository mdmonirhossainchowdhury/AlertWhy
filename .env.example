# Copy this file to .env, then fill in credentials locally. Never commit .env.

# --- Zetaris (data layer). "auto" uses Zetaris when its URL and API key are set,
# otherwise the app explicitly identifies its local DuckDB demo fallback.
FEDERATION_BACKEND=auto
# Local Zetaris default; use the REST URL shown by your Zetaris installation.
# ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# ZETARIS_API_KEY=

# --- Meterless Nightshift (primary AI provider). Copy the Runtime URL and token
# from the Nightshift Console; the URL may differ from the local example.
# METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# METERLESS_RUNTIME_TOKEN=
# METERLESS_MODEL=meterless/auto

# --- Optional secondary OpenAI-compatible provider (e.g. NVIDIA Nemotron).
# Nightshift remains the primary provider when both are configured.
# MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
# MODEL_API_KEY=
# NEMOTRON_MODEL=<model id you have access to>

# --- Optional Zetaris sample datasource setup (for the demo Postgres databases).
# ALERTWHY_PG_PASSWORD=
# ALERTWHY_PG_USER=alertwhy
# ALERTWHY_PG_PORT=5433
# ALERTWHY_PG_HOST_FOR_ZETARIS=host.docker.internal

# --- Cost model (estimates only; edit freely)
COST_PER_QUERY_USD=0.0002
COST_PER_1K_TOKENS_USD=0.002
MAX_COST_PER_INVESTIGATION_USD=0.05
MANUAL_MINUTES_PER_ALERT=25
ANALYST_HOURLY_USD=45
